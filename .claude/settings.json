{
  "sandbox": {
    "enabled": false
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/check-fork-changelog.mjs", "session-start"],
            "timeout": 20,
            "statusMessage": "Recording fork-changelog baseline"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/check-fork-changelog.mjs", "record-edit"],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/check-fork-changelog.mjs", "stop"],
            "timeout": 30,
            "statusMessage": "Checking FORK-CHANGELOG.md"
          }
        ]
      }
    ]
  }
}
