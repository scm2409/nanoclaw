# Dependencies
node_modules/
.npm-cache/
# pnpm content-addressable store (created when running in sandbox mode)
.pnpm-store/
# Build output
dist/

# Local data & auth
store/
data/
logs/

# Groups - per-installation state, not tracked, EXCEPT the capability config
# that makes this fork actually *ours*: standing persona and custom Task-tool
# subagents. Those survive a fresh clone/reinstall and are part of this
# fork's history like any other change. Explicitly still excluded: chat
# transcripts (conversations/), personal memory (memory/), install-specific
# facts (instructions.local.md — names boards, mailboxes, hosts; the reason
# tracked skills can stay free of personal names), and anything regenerated
# at spawn time (CLAUDE.md, container.json, .claude-fragments/ — the last one
# is already excluded below).
groups/*
!groups/*/
groups/*/*
!groups/*/instructions.prepend.md
!groups/*/.claude/
groups/*/.claude/*
!groups/*/.claude/agents/
# Operational scripts belong with the group config that is tracked (personas,
# subagent files): they are reviewed and versioned, not personal state. Their
# install-specific values live in an untracked .env beside them, so no host,
# account or board id reaches this public repo.
!groups/*/scripts/
groups/*/scripts/*.env

# Runtime lock written by the scheduled-tasks hook. It was tracked once by
# accident and then showed up as a pending deletion in every session.
.claude/scheduled_tasks.lock

# Composer-managed CLAUDE.md artifacts (regenerated every spawn) and
# per-group memory (CLAUDE.local.md) must never be committed.
**/CLAUDE.local.md
**/.claude-shared.md
**/.claude-fragments/

# Secrets
*.keys.json
.env
.env*

# Temp files
.tmp-*

# OS
.DS_Store

# IDE
.idea/
.vscode/

# Skills system (local per-installation state)
.nanoclaw/

agents-sdk-docs
.agents
AGENTS.md

# Internal working docs, never committed
docs/maintainer-guide.md
docs/drafts/
forks.md

# Config changelog — local record of DB-only ncl changes, may contain
# personal/operational details not meant for the public repo
/CONFIG-CHANGELOG.md
