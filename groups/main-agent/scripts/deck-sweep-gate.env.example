# Install-specific values for deck-sweep-gate.sh. Copy to deck-sweep-gate.env
# (untracked) and fill in. No secrets belong here -- the OneCLI gateway
# supplies the credential at request time.
NC_HOST=https://nextcloud.example.org
NC_USER=your-nextcloud-account
BOARD_ID=1
# Stack ids to watch, space separated. Watch only the stacks that represent
# work in progress: a Review stack is an automation gate and a Done stack is
# finished work, so churn in either must never wake the agent.
WATCHED_STACKS="10 11"
# Ticks between forced full sweeps. A pure delta gate delivers a card that
# carries an unexecuted next step exactly once; every FORCE_FULL_EVERY ticks
# the gate wakes the agent regardless and hands it every card in the watched
# stacks, so such a card gets picked up again. 0 disables. Default: 8.
FORCE_FULL_EVERY=8
